rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['adi.kalina@gmail.com'];
    }
    // Each signed-in user can read and write only their own progress document.
    // The admin (dashboard at admin.html) can read every user's document, but not change it.
    // One-time progress handoff from the previous Firebase project.
    // The admin writes migrate/{email}; that user reads it once on first sign-in and deletes it.
    match /migrate/{email} {
      allow read, delete: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
      allow read, write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
